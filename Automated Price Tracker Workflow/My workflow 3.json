    {
      "parameters": {
        "jsCode": "// Pega os dados do item gerado pelo nó Aggregate\nconst data = $input.all()[0].json;\nconst tickers = data.Ticker || [];\nconst cotacoes = data.Cotação || [];\n\n// Inicia a mensagem com título e abre a tag <pre> para fonte monoespassada (tabela)\nlet message = `<b>📊 Cotações Atualizadas</b>\\n\\n`;\nmessage += `<pre>`;\nmessage += `Ticker     | Preço\\n`;\nmessage += `-----------+-----------\\n`;\n\n// Preenche as linhas alinhando os textos\nfor (let i = 0; i < tickers.length; i++) {\n  const ticker = String(tickers[i]).padEnd(10, ' ');\n  const cotacao = String(cotacoes[i]).padEnd(11, ' ');\n  message += `${ticker} | ${cotacao}\\n`;\n}\n\nmessage += `</pre>`;\n\n// Retorna a mensagem\nreturn [{ json: { message } }];"
      },
