    {
      "parameters": {
        "jsCode": "// Pega os dados do item gerado pelo nó Aggregate\nconst data = $input.all()[0].json;\nconst tickers = data.Ticker || [];\nconst cotacoes = data.Cotação || [];\n\n// Cria a estrutura HTML da tabela com estilos básicos para e-mail\nlet htmlTable = `\n<table style=\"border-collapse: collapse; width: 100%; font-family: Arial, sans-serif;\">\n  <thead>\n    <tr style=\"background-color: #f2f2f2; text-align: left;\">\n      <th style=\"border: 1px solid #ddd; padding: 8px;\">Ticker</th>\n      <th style=\"border: 1px solid #ddd; padding: 8px;\">Preço</th>\n    </tr>\n  </thead>\n  <tbody>\n`;\n\n// Preenche as linhas da tabela com os dados correspondentes\nfor (let i = 0; i < tickers.length; i++) {\n  htmlTable += `\n    <tr>\n      <td style=\"border: 1px solid #ddd; padding: 8px;\">${tickers[i]}</td>\n      <td style=\"border: 1px solid #ddd; padding: 8px;\">${cotacoes[i]}</td>\n    </tr>\n  `;\n}\n\nhtmlTable += `\n  </tbody>\n</table>\n`;\n\n// Retorna o HTML em uma nova propriedade chamada 'htmlTable'\nreturn [{ json: { htmlTable } }];"
      },
